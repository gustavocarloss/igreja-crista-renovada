generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  attending Event[]
}

model Book {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  order Int
  chapters Int?
  versesCount Int?
  Verse Verse[]
}

model Verse {
  id         Int    @id @default(autoincrement())
  bookId     Int
  book       Book   @relation(fields: [bookId], references: [id])
  chapter    Int
  verse      Int
  text       String?
}

model Event {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  horario     String
  local       String
  pastor      String?
  aoVivo      Boolean  @default(false)
  link        String?
  date        DateTime?
  attendees   User[]
}
